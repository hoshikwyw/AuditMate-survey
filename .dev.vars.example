# Copy this file to .dev.vars (never commit .dev.vars) for local testing with `npm run dev:api`.
# In production, set the same names in Cloudflare: Pages project → Settings → Variables and Secrets.

# From https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Where her answers are emailed. Without a verified domain, Resend only delivers
# to the email address you signed up to Resend with — so use that one.
TO_EMAIL="you@example.com"

# Optional. Leave empty to use Resend's test sender (onboarding@resend.dev).
FROM_EMAIL=""
